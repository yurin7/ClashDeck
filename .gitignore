.flutter-plugins-dependencies
build/
pubspec.lock.bak
*.iml

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/.kotlin/
*.apk
*.aab
*.jks
*.keystore

# 内核二进制：118 MB，且 GitHub 单文件上限 100 MB。
# 用 tool/build_core.ps1 本地构建（需要 Go 与 mihomo 源码），见 README「构建内核」。
android/app/src/main/jniLibs/**/*.so

# IDE / 系统
.idea/
.vscode/
*.log
Thumbs.db
.DS_Store

# 本地备份
*.bak

# 发布签名：这两个文件要进仓库，CI 才能每次用同一个 key 签名（新包可直接覆盖安装升级）
!android/key.properties
!android/app/*.jks
